+            assert MultilingualRefusalDetector(lang).detect("p", text).detected is True, text
+    assert RefusalDetector().detect("p", "I\u2019m unable to help.").detected is False
+    assert MultilingualRefusalDetector("en").detect("p", "I\u2019m unable to help.").detected
