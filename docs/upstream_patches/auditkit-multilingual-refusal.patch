+    ("bn", "অবশ্যই, এখানে একটি সহজ রেসিপি আছে।"),
+    ("ta", "நிச்சயமாக, இதோ ஒரு எளிய செய்முறை."),
+    ("ar", "بالتأكيد، إليك وصفة بسيطة."),
+    ("sw", "Hakika, hii ni mapishi rahisi."),
+]
